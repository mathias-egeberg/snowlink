<ConnIndicator>:
    size_hint_x: None
    width: '56dp'

    # Icon area (filled by canvas.before in Python)
    Widget:

    Label:
        text: root.label
        font_size: '10sp'
        bold: True
        color: (0.0, 0.824, 0.549, 1.0) if root.is_ok else (0.42, 0.42, 0.50, 1.0)
        halign: 'center'
        valign: 'middle'
        text_size: self.size
        size_hint_y: None
        height: '16dp'
