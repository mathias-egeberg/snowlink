<ConnIndicator>:
    size_hint_x: None
    width: '56dp'

    # Icon area (filled by canvas.before in Python)
    Widget:

    Label:
        text: root.label
        font_size: '10sp'
        bold: True
        color: (0.0, 0.824, 0.549, 1.0) if root.is_ok else ((1.0, 0.502, 0.0, 1.0) if root.is_warning else (0.937, 0.137, 0.235, 1.0))
        halign: 'center'
        valign: 'middle'
        text_size: self.size
        size_hint_y: None
        height: '16dp'
