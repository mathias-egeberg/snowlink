<MapScreen>:
    BoxLayout:
        orientation: 'vertical'
        spacing: 0

        # ── Header bar ────────────────────────────────────────────────────
        BoxLayout:
            orientation: 'horizontal'
            size_hint_y: None
            height: '70dp'
            padding: '24dp', '10dp'
            spacing: '12dp'
            canvas.before:
                Color:
                    rgba: 0.086, 0.129, 0.243, 1
                Rectangle:
                    pos: self.pos
                    size: self.size
                Color:
                    rgba: 0.0, 0.706, 0.847, 0.3
                Line:
                    points: [self.x, self.y, self.right, self.y]
                    width: 1

            Label:
                text: 'Map'
                font_size: '24sp'
                bold: True
                color: 0.0, 0.706, 0.847, 1
                size_hint_x: None
                width: '120dp'
                halign: 'left'
                valign: 'middle'
                text_size: self.size

            Label:
                text: '60.0137563 N  11.0196226 E'
                font_size: '13sp'
                color: 0.612, 0.639, 0.686, 1
                halign: 'left'
                valign: 'middle'
                text_size: self.size

            Widget:

            # GPS fix status
            BoxLayout:
                orientation: 'vertical'
                size_hint_x: None
                width: '110dp'
                padding: '0dp', '8dp'
                spacing: '2dp'

                Label:
                    text: 'GPS'
                    font_size: '10sp'
                    color: 0.612, 0.639, 0.686, 1
                    halign: 'right'
                    valign: 'middle'
                    text_size: self.size

                Label:
                    id: lbl_gps_status
                    text: 'No Fix'
                    font_size: '12sp'
                    bold: True
                    color: 0.937, 0.137, 0.235, 1
                    halign: 'right'
                    valign: 'middle'
                    text_size: self.size

            ConnIndicator:
                id: ind_5g
                label: '5G'
                icon_type: '5g'

            ConnIndicator:
                id: ind_gps
                label: 'GPS'
                icon_type: 'gps'

            ConnIndicator:
                id: ind_imu
                label: 'IMU'
                icon_type: 'imu'

            BoxLayout:
                orientation: 'vertical'
                size_hint_x: None
                width: '210dp'

                Label:
                    id: lbl_time_map
                    text: '--:--:--'
                    font_size: '22sp'
                    bold: True
                    color: 0.910, 0.910, 0.910, 1
                    halign: 'right'
                    valign: 'bottom'
                    text_size: self.size

                Label:
                    id: lbl_date_map
                    text: '---'
                    font_size: '12sp'
                    color: 0.612, 0.639, 0.686, 1
                    halign: 'right'
                    valign: 'top'
                    text_size: self.size

            ExitButton:

        # ── Map placeholder – Chromium renders over this widget ───────────
        FloatLayout:
            id: map_placeholder
            canvas.before:
                Color:
                    rgba: 0.051, 0.075, 0.161, 1
                Rectangle:
                    pos: self.pos
                    size: self.size

            Label:
                id: map_no_browser
                opacity: 0
                text: 'Chromium browser not found.\nInstall chromium or chromium-browser to view the 3D map.'
                font_size: '15sp'
                color: 0.612, 0.639, 0.686, 1
                halign: 'center'
                valign: 'middle'
                text_size: self.width, None
                pos_hint: {'center_x': 0.5, 'center_y': 0.5}
                size_hint: 0.8, None
                height: self.texture_size[1]
