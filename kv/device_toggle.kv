<DeviceToggle>:
    orientation: 'horizontal'
    padding: '20dp', '18dp'
    spacing: '16dp'
    canvas.before:
        # Card fill — accent tint when on, default card colour when off
        Color:
            rgba: (0.0, 0.706, 0.847, 0.12) if root.is_on else (0.059, 0.204, 0.376, 1)
        RoundedRectangle:
            pos: self.pos
            size: self.size
            radius: [dp(14), dp(14), dp(14), dp(14)]
        # Border — accent when on, subtle grey when off
        Color:
            rgba: (0.0, 0.706, 0.847, 1) if root.is_on else (0.3, 0.3, 0.36, 0.5)
        Line:
            rounded_rectangle: [self.x + 1, self.y + 1, self.width - 2, self.height - 2, dp(14)]
            width: 1.5

    # Left side: label + status text
    BoxLayout:
        orientation: 'vertical'
        spacing: '6dp'

        Label:
            text: root.device_label
            font_size: '20sp'
            bold: True
            color: 0.910, 0.910, 0.910, 1
            halign: 'left'
            valign: 'middle'
            text_size: self.size

        Label:
            text: '[b]ON[/b]' if root.is_on else 'OFF'
            markup: True
            font_size: '15sp'
            color: (0.0, 0.706, 0.847, 1) if root.is_on else (0.612, 0.639, 0.686, 1)
            halign: 'left'
            valign: 'top'
            text_size: self.size

    # Right side: action button
    BoxLayout:
        size_hint_x: None
        width: '120dp'
        padding: 0

        Button:
            text: 'TURN ON' if not root.is_on else 'TURN OFF'
            font_size: '14sp'
            bold: True
            background_color: 0, 0, 0, 0
            color: 0.910, 0.910, 0.910, 1
            canvas.before:
                Color:
                    rgba: (0.0, 0.706, 0.847, 1) if not root.is_on else (0.937, 0.137, 0.235, 0.9)
                RoundedRectangle:
                    pos: self.pos
                    size: self.size
                    radius: [dp(10), dp(10), dp(10), dp(10)]
            on_release: root.toggle()
