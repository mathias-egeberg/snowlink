<SettingsScreen>:
    BoxLayout:
        orientation: 'vertical'
        spacing: 0

        # ── Header bar ────────────────────────────────────────────────────
        BoxLayout:
            orientation: 'horizontal'
            size_hint_y: None
            height: '70dp'
            padding: '24dp', '10dp'
            canvas.before:
                Color:
                    rgba: 0.086, 0.129, 0.243, 1
                Rectangle:
                    pos: self.pos
                    size: self.size
                Color:
                    rgba: 0.0, 0.706, 0.847, 0.3
                Line:
                    points: [self.x, self.y, self.right, self.y]
                    width: 1

            Label:
                text: 'Settings'
                font_size: '24sp'
                bold: True
                color: 0.0, 0.706, 0.847, 1
                halign: 'left'
                valign: 'middle'
                text_size: self.size

            Widget:

            ExitButton:

        # ── Scrollable settings list ──────────────────────────────────────
        ScrollView:
            do_scroll_x: False

            BoxLayout:
                orientation: 'vertical'
                padding: '24dp', '20dp'
                spacing: '14dp'
                size_hint_y: None
                height: self.minimum_height

                # ── Activation Threshold ──────────────────────────────────
                BoxLayout:
                    orientation: 'horizontal'
                    size_hint_y: None
                    height: '80dp'
                    padding: '20dp', '14dp'
                    spacing: '12dp'
                    canvas.before:
                        Color:
                            rgba: 0.086, 0.129, 0.243, 1
                        RoundedRectangle:
                            pos: self.pos
                            size: self.size
                            radius: [dp(12), dp(12), dp(12), dp(12)]

                    BoxLayout:
                        orientation: 'vertical'
                        spacing: '2dp'

                        Label:
                            text: 'Activation Threshold'
                            font_size: '17sp'
                            bold: True
                            color: 0.910, 0.910, 0.910, 1
                            halign: 'left'
                            text_size: self.size

                        Label:
                            text: 'Temperature to start heating'
                            font_size: '13sp'
                            color: 0.612, 0.639, 0.686, 1
                            halign: 'left'
                            text_size: self.size

                    # Stepper control
                    BoxLayout:
                        orientation: 'horizontal'
                        size_hint_x: None
                        width: '220dp'
                        spacing: '8dp'

                        Button:
                            text: '-'
                            size_hint_x: None
                            width: '52dp'
                            font_size: '22sp'
                            bold: True
                            background_color: 0, 0, 0, 0
                            color: 0.910, 0.910, 0.910, 1
                            canvas.before:
                                Color:
                                    rgba: 0.0, 0.706, 0.847, 0.25
                                RoundedRectangle:
                                    pos: self.pos
                                    size: self.size
                                    radius: [dp(8), dp(8), dp(8), dp(8)]
                            on_release: root.decrement_threshold()

                        Label:
                            text: ('+' if root.activation_threshold >= 0 else '') + '{:.1f} C'.format(root.activation_threshold)
                            font_size: '18sp'
                            bold: True
                            color: 0.0, 0.706, 0.847, 1
                            halign: 'center'
                            valign: 'middle'
                            text_size: self.size

                        Button:
                            text: '+'
                            size_hint_x: None
                            width: '52dp'
                            font_size: '22sp'
                            bold: True
                            background_color: 0, 0, 0, 0
                            color: 0.910, 0.910, 0.910, 1
                            canvas.before:
                                Color:
                                    rgba: 0.0, 0.706, 0.847, 0.25
                                RoundedRectangle:
                                    pos: self.pos
                                    size: self.size
                                    radius: [dp(8), dp(8), dp(8), dp(8)]
                            on_release: root.increment_threshold()

                # ── System Mode ───────────────────────────────────────────
                BoxLayout:
                    orientation: 'horizontal'
                    size_hint_y: None
                    height: '80dp'
                    padding: '20dp', '14dp'
                    spacing: '12dp'
                    canvas.before:
                        Color:
                            rgba: 0.086, 0.129, 0.243, 1
                        RoundedRectangle:
                            pos: self.pos
                            size: self.size
                            radius: [dp(12), dp(12), dp(12), dp(12)]

                    BoxLayout:
                        orientation: 'vertical'
                        spacing: '2dp'

                        Label:
                            text: 'System Mode'
                            font_size: '17sp'
                            bold: True
                            color: 0.910, 0.910, 0.910, 1
                            halign: 'left'
                            text_size: self.size

                        Label:
                            text: 'Auto activates based on temperature'
                            font_size: '13sp'
                            color: 0.612, 0.639, 0.686, 1
                            halign: 'left'
                            text_size: self.size

                    Button:
                        size_hint_x: None
                        width: '130dp'
                        text: root.system_mode
                        font_size: '16sp'
                        bold: True
                        background_color: 0, 0, 0, 0
                        color: 0.910, 0.910, 0.910, 1
                        canvas.before:
                            Color:
                                rgba: (0.0, 0.706, 0.847, 1) if root.system_mode == 'Auto' else (1.0, 0.718, 0.012, 1)
                            RoundedRectangle:
                                pos: self.pos
                                size: self.size
                                radius: [dp(10), dp(10), dp(10), dp(10)]
                        on_release: root.toggle_mode()

                # ── Display Brightness ────────────────────────────────────
                BoxLayout:
                    orientation: 'horizontal'
                    size_hint_y: None
                    height: '80dp'
                    padding: '20dp', '14dp'
                    spacing: '12dp'
                    canvas.before:
                        Color:
                            rgba: 0.086, 0.129, 0.243, 1
                        RoundedRectangle:
                            pos: self.pos
                            size: self.size
                            radius: [dp(12), dp(12), dp(12), dp(12)]

                    BoxLayout:
                        orientation: 'vertical'
                        spacing: '2dp'

                        Label:
                            text: 'Display Brightness'
                            font_size: '17sp'
                            bold: True
                            color: 0.910, 0.910, 0.910, 1
                            halign: 'left'
                            text_size: self.size

                        Label:
                            text: '{:.0f}%'.format(root.brightness * 100)
                            font_size: '13sp'
                            color: 0.612, 0.639, 0.686, 1
                            halign: 'left'
                            text_size: self.size

                    Slider:
                        size_hint_x: None
                        width: '220dp'
                        min: 0.1
                        max: 1.0
                        step: 0.05
                        value: root.brightness
                        cursor_size: dp(28), dp(28)
                        on_value: root.brightness = self.value

                # ── App Version (read-only) ───────────────────────────────
                BoxLayout:
                    orientation: 'horizontal'
                    size_hint_y: None
                    height: '66dp'
                    padding: '20dp', '14dp'
                    canvas.before:
                        Color:
                            rgba: 0.086, 0.129, 0.243, 1
                        RoundedRectangle:
                            pos: self.pos
                            size: self.size
                            radius: [dp(12), dp(12), dp(12), dp(12)]

                    Label:
                        text: 'Application Version'
                        font_size: '17sp'
                        bold: True
                        color: 0.910, 0.910, 0.910, 1
                        halign: 'left'
                        valign: 'middle'
                        text_size: self.size

                    Label:
                        text: root.app_version
                        font_size: '16sp'
                        color: 0.612, 0.639, 0.686, 1
                        halign: 'right'
                        valign: 'middle'
                        text_size: self.size
