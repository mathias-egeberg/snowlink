<ControlScreen>:
    BoxLayout:
        orientation: 'vertical'
        spacing: 0

        # ── Header bar ────────────────────────────────────────────────────
        BoxLayout:
            orientation: 'horizontal'
            size_hint_y: None
            height: '70dp'
            padding: '24dp', '10dp'
            spacing: '12dp'
            canvas.before:
                Color:
                    rgba: 0.086, 0.129, 0.243, 1
                Rectangle:
                    pos: self.pos
                    size: self.size
                Color:
                    rgba: 0.0, 0.706, 0.847, 0.3
                Line:
                    points: [self.x, self.y, self.right, self.y]
                    width: 1

            Label:
                text: 'Device Control'
                font_size: '24sp'
                bold: True
                color: 0.0, 0.706, 0.847, 1
                halign: 'left'
                valign: 'middle'
                text_size: self.size

            # Connection status indicators
            ConnIndicator:
                id: ind_5g
                label: '5G'
                icon_type: '5g'

            ConnIndicator:
                id: ind_gps
                label: 'GPS'
                icon_type: 'gps'

            ConnIndicator:
                id: ind_imu
                label: 'IMU'
                icon_type: 'imu'

            # Clock + date
            BoxLayout:
                orientation: 'vertical'
                size_hint_x: None
                width: '210dp'

                Label:
                    id: lbl_time_ctrl
                    text: '--:--:--'
                    font_size: '22sp'
                    bold: True
                    color: 0.910, 0.910, 0.910, 1
                    halign: 'right'
                    valign: 'bottom'
                    text_size: self.size

                Label:
                    id: lbl_date_ctrl
                    text: '---'
                    font_size: '12sp'
                    color: 0.612, 0.639, 0.686, 1
                    halign: 'right'
                    valign: 'top'
                    text_size: self.size

            ExitButton:

        # ── 2×2 device toggle grid ────────────────────────────────────────
        GridLayout:
            cols: 2
            padding: '20dp'
            spacing: '16dp'

            DeviceToggle:
                id: toggle_roof
                device_label: 'Roof Heater'
                device_key: 'heat_roof_on'

            DeviceToggle:
                id: toggle_gutter
                device_label: 'Gutter Heater'
                device_key: 'heat_gutter_on'

            DeviceToggle:
                id: toggle_pump
                device_label: 'Water Pump'
                device_key: 'pump_on'

            DeviceToggle:
                id: toggle_sensor_light
                device_label: 'Sensor Light'
                device_key: 'sensor_light_on'
