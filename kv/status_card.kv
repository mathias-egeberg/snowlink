<StatusCard>:
    orientation: 'vertical'
    padding: '18dp', '16dp'
    spacing: '6dp'
    canvas.before:
        Color:
            rgba: root.card_color
        RoundedRectangle:
            pos: self.pos
            size: self.size
            radius: [dp(14), dp(14), dp(14), dp(14)]

    # Section label (e.g. "Outside Temperature")
    Label:
        text: root.label
        font_size: '13sp'
        color: 0.612, 0.639, 0.686, 1
        size_hint_y: None
        height: '22dp'
        halign: 'left'
        valign: 'middle'
        text_size: self.size

    # Value + unit row
    BoxLayout:
        orientation: 'horizontal'
        spacing: '6dp'

        Label:
            text: root.value
            font_size: '42sp'
            bold: True
            color: 0.910, 0.910, 0.910, 1
            halign: 'left'
            valign: 'middle'
            text_size: self.size

        Label:
            text: root.unit
            font_size: '18sp'
            color: 0.612, 0.639, 0.686, 1
            size_hint_x: None
            width: '40dp'
            halign: 'left'
            valign: 'bottom'
            text_size: self.size
