<ExitButton>:
    size_hint_x: None
    width: '70dp'
    canvas.before:
        Color:
            rgba: (0.75, 0.10, 0.10, 0.18)
        RoundedRectangle:
            pos:  self.x + dp(8), self.y + dp(10)
            size: self.width - dp(16), self.height - dp(20)
            radius: [dp(6)]
    canvas:
        Color:
            rgba: (0.95, 0.25, 0.25, 1)
        Line:
            points: [self.center_x - dp(10), self.center_y - dp(10), self.center_x + dp(10), self.center_y + dp(10)]
            width: 2.5
            cap: 'round'
        Line:
            points: [self.center_x + dp(10), self.center_y - dp(10), self.center_x - dp(10), self.center_y + dp(10)]
            width: 2.5
            cap: 'round'


<NavButton>:
    orientation: 'vertical'
    padding: '8dp', '8dp'
    spacing: '2dp'
    canvas.before:
        # Subtle highlight tint for the active tab
        Color:
            rgba: (0.0, 0.706, 0.847, 0.12) if self.is_active else (0, 0, 0, 0)
        Rectangle:
            pos: self.pos
            size: self.size
    canvas.after:
        # Top accent line for the active tab
        Color:
            rgba: (0.0, 0.706, 0.847, 1) if self.is_active else (0, 0, 0, 0)
        Line:
            points: [self.x + dp(28), self.top - dp(2), self.right - dp(28), self.top - dp(2)]
            width: 3

    Label:
        text: root.text
        font_size: '15sp'
        bold: root.is_active
        color: (0.0, 0.706, 0.847, 1) if root.is_active else (0.612, 0.639, 0.686, 1)
        halign: 'center'
        valign: 'middle'
        text_size: self.size


<NavBar>:
    orientation: 'horizontal'
    canvas.before:
        Color:
            rgba: 0.047, 0.063, 0.122, 1
        Rectangle:
            pos: self.pos
            size: self.size
        # Top separator line
        Color:
            rgba: 0.0, 0.706, 0.847, 0.4
        Line:
            points: [self.x, self.top, self.right, self.top]
            width: 1

    NavButton:
        text: 'Dashboard'
        is_active: root.active_tab == 'dashboard'
        on_release: root.go_to('dashboard')

    NavButton:
        text: 'Control'
        is_active: root.active_tab == 'control'
        on_release: root.go_to('control')

    NavButton:
        text: 'Settings'
        is_active: root.active_tab == 'settings'
        on_release: root.go_to('settings')
